# Copy to .env for local chat-stack demos. Never commit real values.
# The faux demo (npm run demo) needs no keys.

# OpenAI-compatible chat completions (e.g. Aliyun Token Plan)
# Used by: npm run demo:chat
PI_DURABLE_CHAT_API_KEY=

# Optional: override chat base URL (default is documented in demos/lib-providers.mjs)
# PI_DURABLE_CHAT_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Optional: Anthropic-compatible gateway key if you extend the provider matrix
# PI_DURABLE_ANTHROPIC_API_KEY=
